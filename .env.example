# Non-secret local configuration template.
# Copy to .env for your own testing if desired. Do not put private keys,
# refresh tokens, or service-account JSON content in env files.

PIPELINE_ENV=dev
SOURCE_DIR=main/data
PROCESSING_DIR=main/processing

PROJECT_ID=
DATASET=de_test_dataset
REGION=EU
BUCKET=
GCS_BUCKET=

# Optional explicit hourly replay bounds. Normal runs discover pending batches.
DATA_INTERVAL_START=
DATA_INTERVAL_END=

# Production mode is the default. Set NO_PRODUCTION_LAYERS=true, or run
# `make run-fast`, when you want a faster local-only run.
NO_PRODUCTION_LAYERS=false
NO_KAFKA=false
NO_SPARK=false
NO_S3=false
NO_AIRFLOW=false
NO_DATABRICKS=false
